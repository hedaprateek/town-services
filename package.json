{
  "name": "society-and-town-directory",
  "private": true,
  "version": "2.0.0",
  "scripts": {
    "build": "node scripts/build-private.cjs",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "firebase:rules": "firebase deploy --only firestore",
    "test:rules": "firebase emulators:exec --project demo-community-directory --only firestore \"node --test tests/firestore-rules.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.2.0",
    "firebase-tools": "15.35.0",
    "jose": "6.2.15",
    "wrangler": "4.158.0"
  },
  "engines": {
    "node": ">=22"
  }
}
