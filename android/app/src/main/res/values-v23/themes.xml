<?xml version="1.0" encoding="utf-8"?>
<!-- Android 6 and up can be told to draw dark status-bar icons, which the town
     build needs because its background is paper-coloured. -->
<resources>
  <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
    <item name="android:windowBackground">@color/launch_bg</item>
    <item name="android:statusBarColor">@color/launch_bg</item>
    <item name="android:navigationBarColor">@color/launch_bg</item>
    <item name="android:windowLightStatusBar">@bool/light_status</item>
  </style>
</resources>
